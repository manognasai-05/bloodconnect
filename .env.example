# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT=3000

# JWT_SECRET: Secret for signing JWT authentication tokens
JWT_SECRET="bloodconnect_secure_jwt_secret_token_2026"

# MONGODB_URI: MongoDB connection URI (e.g. mongodb://localhost:27017/bloodconnect or MongoDB Atlas)
# If omitted, BloodConnect seamlessly uses the built-in persistent document store pre-populated with demo data.
MONGODB_URI=""
